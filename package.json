{
  "name": "habit-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "desktop",
    "mobile"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "dev:desktop": "concurrently \"npm:dev:server\" \"npm:dev:client\" \"npm --workspace desktop run dev\"",
    "dev:mobile": "npm --workspace mobile run start",
    "preview:lan": "npm run build && concurrently \"npm --workspace server run start\" \"npm --workspace client run preview -- --host 0.0.0.0 --port 4173 --strictPort\"",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "build:desktop": "npm --workspace client run build -- --base=./ && npm --workspace desktop run build",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm --workspace server run lint",
    "lint:client": "npm --workspace client run lint",
    "format": "prettier --write .",
    "seed": "npm --workspace server run seed",
    "test": "npm --workspace server run check && npm --workspace server run check:tracking",
    "test:e2e": "npm run build:client && playwright test",
    "test:integration": "npm --workspace server run check:integration",
    "check:mobile": "npm --workspace mobile run typecheck && npm --workspace mobile run check:auth && npm --workspace mobile run check:reminders && npm --workspace mobile run check:native && npm --workspace mobile run check:assets && npm --workspace mobile run check:achievements",
    "check": "npm run lint && npm run build && npm test && npm run test:integration && npm run check:mobile && npm --workspace client run check:worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "app-builder-bin": "^5.0.0-alpha.10",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "expo": "~52.0.49",
    "expo-router": "~4.0.22",
    "globals": "^16.0.0",
    "metro-cache-key": "^0.81.5",
    "metro-minify-terser": "^0.81.5",
    "metro-transform-plugins": "^0.81.5",
    "prettier": "^3.5.3",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "typescript-eslint": "^8.30.1"
  },
  "dependencies": {
    "browserslist": "^4.29.0",
    "metro-cache": "0.81.5",
    "metro-config": "0.81.5",
    "metro-core": "0.81.5",
    "metro-resolver": "0.81.5",
    "metro-transform-worker": "0.81.5",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "expo": "~52.0.49",
    "tar": "7.5.22",
    "postcss": "8.5.28",
    "@xmldom/xmldom": "0.8.15",
    "image-size": "2.0.4"
  }
}
