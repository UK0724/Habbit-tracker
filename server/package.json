{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --import tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check": "node --import tsx/esm src/checks.ts",
    "check:tracking": "node --import tsx/esm src/tracking.checks.ts",
    "check:integration": "node --import tsx/esm src/integration.checks.ts",
    "check:lambda": "node --import tsx/esm src/lambda.checks.ts",
    "preview:test": "node --import tsx/esm src/preview.ts",
    "check:account": "node --import tsx/esm src/account.checks.ts",
    "check:rewards": "node --import tsx/esm src/rewards.checks.ts"
  },
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "serverless-http": "^4.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^6.4.24",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
