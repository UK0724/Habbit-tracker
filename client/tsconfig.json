{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "react": ["../node_modules/@types/react"],
      "react/*": ["../node_modules/@types/react/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
