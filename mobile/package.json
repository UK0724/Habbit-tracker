{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/expo.cjs start",
    "android": "node scripts/expo.cjs start --android",
    "ios": "node scripts/expo.cjs start --ios",
    "web": "node scripts/expo.cjs start --web",
    "typecheck": "tsc --noEmit",
    "check:auth": "node tests/authStore.check.cjs",
    "check:reminders": "node tests/reminders.check.cjs",
    "export:check": "node scripts/expo.cjs export --platform android --platform ios --max-workers 2",
    "check:native": "node tests/nativeDependencies.check.cjs && node tests/urlDecoding.check.cjs && node tests/androidPermissions.check.cjs",
    "check:assets": "node tests/brandAssets.check.cjs",
    "check:achievements": "node tests/achievements.check.cjs && node tests/format.check.cjs && node tests/streakRepair.check.cjs && node tests/share.check.cjs && node tests/onboarding.check.cjs",
    "check:format": "node tests/format.check.cjs",
    "check:expenses": "node tests/expenses.check.cjs",
    "check:onboarding": "node tests/onboarding.check.cjs",
    "generate:sounds": "node scripts/generate-sounds.cjs"
  },
  "dependencies": {
    "@habit-tracker/shared": "*",
    "@hookform/resolvers": "^3.9.1",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.0",
    "expo-av": "~15.0.1",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.3",
    "expo-haptics": "~14.0.0",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.3",
    "expo-notifications": "~0.29.11",
    "expo-router": "~4.0.15",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.0",
    "lucide-react-native": "^0.469.0",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-hook-form": "^7.54.0",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-view-shot": "~4.0.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
