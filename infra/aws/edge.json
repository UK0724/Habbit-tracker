{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Pulse CloudFront FREE plan, HTTPS, private Mumbai S3 origin and uncached Lambda API. Deploy in us-east-1. Publish DNS only after verification.",
  "Parameters": {
    "Environment": {"Type": "String", "AllowedValues": ["dev", "prod"], "Default": "dev"},
    "ApiOriginHostname": {"Type": "String", "AllowedPattern": "[a-z0-9]+\\.lambda-url\\.ap-south-1\\.on\\.aws", "Description": "Lambda URL hostname only, no scheme or trailing slash"},
    "HostedZoneId": {"Type": "String", "Default": "Z07756052FLIKFJDVDRZW"},
    "PublishDns": {"Type": "String", "AllowedValues": ["true", "false"], "Default": "false"}
  },
  "Mappings": {"Domains": {"dev": {"Name": "habbit-dev.abuk.in"}, "prod": {"Name": "habbit.abuk.in"}}},
  "Conditions": {"PublishRecords": {"Fn::Equals": [{"Ref": "PublishDns"}, "true"]}},
  "Resources": {
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": {"Fn::FindInMap": ["Domains", {"Ref": "Environment"}, "Name"]},
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [{"DomainName": {"Fn::FindInMap": ["Domains", {"Ref": "Environment"}, "Name"]}, "HostedZoneId": {"Ref": "HostedZoneId"}}]
      }
    },
    "WebAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {"OriginAccessControlConfig": {"Name": {"Fn::Sub": "pulse-${Environment}-web"}, "OriginAccessControlOriginType": "s3", "SigningBehavior": "always", "SigningProtocol": "sigv4"}}
    },
    "SpaRouting": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {"Fn::Sub": "pulse-${Environment}-spa-routing"},
        "AutoPublish": true,
        "FunctionConfig": {"Comment": "Rewrite navigation paths only; missing JS never becomes HTML", "Runtime": "cloudfront-js-2.0"},
        "FunctionCode": "function handler(event) { var r = event.request; if ((r.method === 'GET' || r.method === 'HEAD') && r.uri !== '/api' && r.uri.indexOf('/api/') !== 0 && r.uri.indexOf('/assets/') !== 0 && r.uri.indexOf('/downloads/') !== 0 && r.uri.indexOf('.') === -1) { r.uri = '/index.html'; } return r; }"
      }
    },
    "WebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": {"Fn::Sub": "pulse-${Environment}-edge"}, "Scope": "CLOUDFRONT",
        "DefaultAction": {"Allow": {}},
        "VisibilityConfig": {"SampledRequestsEnabled": false, "CloudWatchMetricsEnabled": false, "MetricName": {"Fn::Sub": "pulse-${Environment}-edge"}}
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Comment": {"Fn::Sub": "Pulse ${Environment}: private web assets and uncached API"},
          "Enabled": true, "HttpVersion": "http2", "IPV6Enabled": true, "DefaultRootObject": "index.html",
          "Aliases": [{"Fn::FindInMap": ["Domains", {"Ref": "Environment"}, "Name"]}],
          "ViewerCertificate": {"AcmCertificateArn": {"Ref": "Certificate"}, "SslSupportMethod": "sni-only", "MinimumProtocolVersion": "TLSv1.2_2021"},
          "WebACLId": {"Fn::GetAtt": ["WebAcl", "Arn"]},
          "Origins": [
            {"Id": "web", "DomainName": {"Fn::Sub": "pulse-${Environment}-web-${AWS::AccountId}-ap-south-1.s3.ap-south-1.amazonaws.com"}, "S3OriginConfig": {"OriginAccessIdentity": ""}, "OriginAccessControlId": {"Ref": "WebAccessControl"}},
            {"Id": "api", "DomainName": {"Ref": "ApiOriginHostname"}, "CustomOriginConfig": {"OriginProtocolPolicy": "https-only", "OriginSSLProtocols": ["TLSv1.2"], "OriginReadTimeout": 30}}
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "web", "ViewerProtocolPolicy": "redirect-to-https", "Compress": true,
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "FunctionAssociations": [{"EventType": "viewer-request", "FunctionARN": {"Fn::GetAtt": ["SpaRouting", "FunctionMetadata.FunctionARN"]}}]
          },
          "CacheBehaviors": [
            {"PathPattern": "/api/*", "TargetOriginId": "api", "ViewerProtocolPolicy": "https-only", "AllowedMethods": ["GET", "HEAD", "OPTIONS", "PUT", "PATCH", "POST", "DELETE"], "CachedMethods": ["GET", "HEAD"], "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad", "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac", "Compress": true},
            {"PathPattern": "/api", "TargetOriginId": "api", "ViewerProtocolPolicy": "https-only", "AllowedMethods": ["GET", "HEAD", "OPTIONS", "PUT", "PATCH", "POST", "DELETE"], "CachedMethods": ["GET", "HEAD"], "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad", "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac", "Compress": true},
            {"PathPattern": "/assets/*", "TargetOriginId": "web", "ViewerProtocolPolicy": "redirect-to-https", "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6", "Compress": true}
          ]
        }
      }
    },
    "FreePlan": {
      "Type": "AWS::PricingPlanManager::Subscription",
      "Properties": {"PlanFamily": "CloudFront", "PlanTier": "FREE", "UsageLevel": "DEFAULT", "ResourceArns": [{"Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}, {"Fn::GetAtt": ["WebAcl", "Arn"]}]}
    },
    "WebBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Fn::Sub": "pulse-${Environment}-web-${AWS::AccountId}-ap-south-1"},
        "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Sid": "ReadWebAssetsFromThisDistribution", "Effect": "Allow", "Principal": {"Service": "cloudfront.amazonaws.com"}, "Action": "s3:GetObject", "Resource": {"Fn::Sub": "arn:${AWS::Partition}:s3:::pulse-${Environment}-web-${AWS::AccountId}-ap-south-1/*"}, "Condition": {"StringEquals": {"AWS:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"}}}}]}
      }
    },
    "DnsA": {
      "Type": "AWS::Route53::RecordSet", "Condition": "PublishRecords", "DependsOn": ["FreePlan", "WebBucketPolicy"],
      "Properties": {"HostedZoneId": {"Ref": "HostedZoneId"}, "Name": {"Fn::FindInMap": ["Domains", {"Ref": "Environment"}, "Name"]}, "Type": "A", "AliasTarget": {"DNSName": {"Fn::GetAtt": ["Distribution", "DomainName"]}, "HostedZoneId": "Z2FDTNDATAQYW2"}}
    },
    "DnsAAAA": {
      "Type": "AWS::Route53::RecordSet", "Condition": "PublishRecords", "DependsOn": ["FreePlan", "WebBucketPolicy"],
      "Properties": {"HostedZoneId": {"Ref": "HostedZoneId"}, "Name": {"Fn::FindInMap": ["Domains", {"Ref": "Environment"}, "Name"]}, "Type": "AAAA", "AliasTarget": {"DNSName": {"Fn::GetAtt": ["Distribution", "DomainName"]}, "HostedZoneId": "Z2FDTNDATAQYW2"}}
    }
  },
  "Outputs": {
    "DistributionDomain": {"Value": {"Fn::GetAtt": ["Distribution", "DomainName"]}},
    "DistributionId": {"Value": {"Ref": "Distribution"}},
    "PlanStatus": {"Value": {"Fn::GetAtt": ["FreePlan", "Status"]}},
    "PlanTier": {"Value": {"Fn::GetAtt": ["FreePlan", "CurrentPlanTier"]}}
  }
}
