{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Pulse private deployment artifacts. Deploy in ap-south-1.",
  "Resources": {
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {"Fn::Sub": "pulse-artifacts-${AWS::AccountId}-${AWS::Region}"},
        "PublicAccessBlockConfiguration": {"BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true},
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "BucketEncryption": {"ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]},
        "VersioningConfiguration": {"Status": "Enabled"},
        "Tags": [{"Key": "Application", "Value": "Pulse"}, {"Key": "ManagedBy", "Value": "CloudFormation"}]
      }
    }
  },
  "Outputs": {"ArtifactsBucket": {"Value": {"Ref": "Artifacts"}}}
}
